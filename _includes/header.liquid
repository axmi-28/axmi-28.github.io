<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <nav class="container site-nav" aria-label="Main navigation">
    <a class="site-name" href="{{ '/' | relative_url }}">Andy<span aria-hidden="true">.</span></a>
    <div class="site-nav-links">
      <a href="{{ '/' | relative_url }}#past-work">Past work</a>
      <a href="{{ '/' | relative_url }}#open-source-interpretability-tooling">Open source</a>
      {% assign nav_pages = site.pages | sort: 'nav_order' %}
      {% for item in nav_pages %}
        {% if item.nav %}
          <a
            href="{{ item.url | relative_url }}"
            {% if item.url == page.url %}
              aria-current="page"
            {% endif %}
          >
            {{- item.title -}}
          </a>
        {% endif %}
      {% endfor %}
      {% if site.enable_darkmode %}
        <button
          id="light-toggle"
          type="button"
          title="Switch between system, light, and dark theme"
          aria-label="Change color theme"
        >
          <i class="fa-half-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
          <i class="fa-solid fa-moon" id="light-toggle-dark" aria-hidden="true"></i>
          <i class="fa-solid fa-sun" id="light-toggle-light" aria-hidden="true"></i>
        </button>
      {% endif %}
    </div>
  </nav>
</header>
