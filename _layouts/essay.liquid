---
layout: default
---
<div class="post essay">
  <header
    class="post-header"
    {% if page.kind == 'note' %}
      id="main-content" tabindex="-1"
    {% endif %}
  >
    <a class="back-link" href="{{ '/' | relative_url }}#writing-{{ page.slug }}">&larr; Writings</a>
    {% unless page.kind == 'note' %}
      <h1 class="post-title" id="main-content" tabindex="-1">{{ page.title | escape }}</h1>
    {% endunless %}
    <div class="essay-meta">
      <time datetime="{{ page.date | date_to_xmlschema }}">
        {{- page.date | date: '%B %-d, %Y' -}}
        {% if page.kind == 'note' %} · {{ page.date | date: '%-I:%M %p' }}{% endif %}
      </time>
      {% if page.pdf %}
        <a href="{{ page.pdf | relative_url }}">Read the PDF &rarr;</a>
      {% endif %}
      {% if page.source_url %}
        <a href="{{ page.source_url | escape }}">Originally on Substack ↗</a>
      {% endif %}
    </div>
    {% if page.description %}
      <p class="page-description">{{ page.description | escape }}</p>
    {% endif %}
  </header>
  <article class="essay-body">
    {{ content }}
  </article>
  <nav class="essay-navigation" aria-label="More writing">
    {% if page.previous %}
      <a href="{{ page.previous.url | relative_url }}">&larr; Older: {{ page.previous.title | escape }}</a>
    {% endif %}
    {% if page.next %}
      <a href="{{ page.next.url | relative_url }}">Newer: {{ page.next.title | escape }} &rarr;</a>
    {% endif %}
  </nav>
  <a class="essay-back" href="{{ '/' | relative_url }}#writing-{{ page.slug }}">&larr; Writings</a>
</div>
