---
layout: default
---
<div class="post personal-home">
  <header class="post-header">
    <h1 class="post-title" id="main-content" tabindex="-1">{{ page.title }}</h1>
    {% if page.permalink == '/' %}
      <div class="contact-links" aria-label="Contact">
        <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}"
          >github / {{ site.data.socials.github_username -}}
        </a>
      </div>
    {% endif %}
  </header>
  <article>{{ content }}</article>
</div>
